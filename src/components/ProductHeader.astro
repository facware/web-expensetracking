---
const APP_URL = 'https://expense-tracking.facware.com';
const SITE_URL = 'https://facware.com';
---

<header class="product-header">
  <div class="container product-header-inner">
    <a href={SITE_URL} class="product-header-back" aria-label="Go to Facware main site" target="_blank">
      Go to Facware
    </a>
    <div class="product-header-brand">
      <img class="product-header-image" src="/assets/images/products/expense-tracking/MainLogo-48x48.png" alt="" width="30" height="30">
      <span>ExpenseTracking</span>
      <span class="product-header-by">by Facware</span>
    </div>
    <a href={APP_URL} class="btn btn-primary product-header-cta" target="_blank" rel="noopener noreferrer">Open the app <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
  </div>
</header>

<style>
  .product-header{background:#0f1230;border-bottom:1px solid rgba(255,255,255,.08)}
  .product-header-inner{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-top:14px;padding-bottom:14px}
  .product-header-back{color:#9fb3d9;text-decoration:none;font-size:14px;font-weight:600;display:inline-flex;align-items:center;gap:8px;transition:color .2s}
  .product-header-back:hover{color:#fff}
  .product-header-brand{color:#fff;font-weight:700;font-size:15px;display:inline-flex;align-items:center;gap:8px}
  .product-header-image{display:block;border-radius:8px;object-fit:contain}
  .product-header-by{color:#7c8db8;font-weight:500;font-size:12px}
  .product-header-cta{padding:10px 18px;font-size:14px}
  @media(max-width:640px){
    .product-header-by{display:none}
    .product-header-cta{font-size:13px;padding:9px 14px}
  }
</style>
